# 文献语料：PDF 与 OCR 产物体积大且可由 metadata.json 重新获取，不入库
.pipeline/literature/**/*.pdf
.pipeline/literature/**/ocr/
.pipeline/literature/**/ocr.log

# omp 插件 skills 的本地副本（第三方代码，由 /omp:setup 重新拷贝）
.claude/skills/

# hook 事件流水
.pipeline/.hook-events/

__pycache__/
*.pyc

# 仅保留最后一次检索的临时结果，无长期价值
.pipeline/literature/**/search_results.json

# 实验结果 JSON 保留, 但排除大文件
experiments/results/*_quick.json

# 实验运行产物: 生成文本体积大, 可由 checkpoint 重跑
experiments/relay/runs/
experiments/relay/logs/
experiments/conformal/data/
experiments/conformal/logs/
